platform :ios, '12.0'

source 'https://cdn.cocoapods.org/'

use_modular_headers!

install! 'cocoapods',
:generate_multiple_pod_projects => true,
:incremental_installation => true,
:deterministic_uuids => true

inhibit_all_warnings!

def lynx_kit
  pod 'Lynx', '3.7.0', :subspecs => [
    'Framework',
    'ReleaseResource'
  ]

  pod 'PrimJS', '3.7.0', :subspecs => ['quickjs', 'napi']

  pod 'LynxService', '3.7.0', :subspecs => [
  'Image',
  'Log',
  'Http',
  'Devtool'
  ]

  pod 'LynxDevtool', '3.7.0', :subspecs => [
   'Framework',
  ]

  pod 'XElement', '3.7.0'

  pod 'DebugRouter/MessageTransceiverEnable', '5.0.15'

  pod 'SDWebImage','5.15.5'
  pod 'SDWebImageWebPCoder', '0.11.0'
end

project 'OpenCodeLynx.xcodeproj'

use_frameworks!
target 'OpenCodeLynx' do
  lynx_kit
end

target 'OpenCodeLynxTests' do
  lynx_kit
end

target 'OpenCodeLynxUITests' do
  lynx_kit
end

post_install do |installer|
  support_dir = File.join(__dir__, 'Pods', 'Target Support Files', 'LynxServiceAPI')
  fallback = '"${PODS_TARGET_SRCROOT}"'

  %w[LynxServiceAPI.debug.xcconfig LynxServiceAPI.release.xcconfig].each do |filename|
    path = File.join(support_dir, filename)
    next unless File.exist?(path)

    content = File.read(path)
    next if content.include?(fallback)

    patched = content.gsub(
      'HEADER_SEARCH_PATHS = $(inherited)',
      "HEADER_SEARCH_PATHS = $(inherited) #{fallback}"
    )
    File.write(path, patched)
  end

  # Per-developer signing injection. ios/Local.xcconfig is gitignored and
  # produced by `pnpm run:ios-device` (or hand-written). When present, its
  # DEVELOPMENT_TEAM / CODE_SIGN_STYLE settings are appended to the
  # Pods-OpenCodeLynx*.xcconfig files so Xcode UI builds pick them up
  # without writing the team back into project.pbxproj.
  local_xcconfig = File.join(__dir__, 'Local.xcconfig')
  if File.exist?(local_xcconfig)
    local_lines = File.readlines(local_xcconfig).reject { |l| l.strip.empty? || l.strip.start_with?('//') }
    if local_lines.any?
      target_xcconfigs = Dir.glob(File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-OpenCodeLynx*', '*.xcconfig'))
      marker = '// >>> opencode_lynx local signing'
      end_marker = '// <<< opencode_lynx local signing'
      target_xcconfigs.each do |path|
        content = File.read(path)
        # Strip any prior injection so we never double-append.
        content = content.sub(/\n#{Regexp.escape(marker)}.*?#{Regexp.escape(end_marker)}\n?/m, '')
        injection = ["\n#{marker}", *local_lines.map(&:rstrip), end_marker, ''].join("\n")
        File.write(path, content + injection)
      end
    end
  end

  installer.generated_projects.each do |project|
    project.save
  end
  installer.aggregate_targets.each do |target|
    user_project = target.user_project
    next unless user_project

    user_project.save
  end
end
