# Local-only iOS device deploy config — copy to .env.ios.local and fill in.
# Read by scripts/run-ios-device.mjs (`pnpm run:ios-device`).
# .env.ios.local is gitignored; do NOT commit your real values.

# Device UDID — get from `xcrun xctrace list devices`
IOS_DEVICE_UDID=00008150-00054DE80183401C

# Apple Developer Team ID (10 chars, NOT the certificate UID)
# Find with: security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
# Look at the OU= field (e.g. OU=YB9TA5FQBW)
IOS_DEVELOPMENT_TEAM=YB9TA5FQBW

# Optional overrides
# IOS_CONFIGURATION=Debug
# IOS_BUNDLE_ID=dev.opencode.lynx.app
# IOS_SKIP_POD_INSTALL=1
# IOS_SKIP_LYNX_BUILD=1
